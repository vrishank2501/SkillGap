# SkillBridge AI Environment Configuration

# Application
ENVIRONMENT=development
PORT=8000
DEBUG=True

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Database URL (Direct PostgreSQL connection to Supabase or local Postgres)
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project.supabase.co:5432/postgres

# Storage
DOCUMENT_STORAGE_DIR=./data/documents
MAX_UPLOAD_SIZE_MB=25

# Optional default API keys (Fallback if user does not enter key in UI session)
DEFAULT_GEMINI_API_KEY=
DEFAULT_OPENAI_API_KEY=

